# Gateway + MLflow runtime (Render). Do not commit real secrets.
# Control-plane DATABASE_URL must be the Neon *unpooled* URL for database neondb.
# MLFLOW_BACKEND_STORE_URI must be the Neon *unpooled* URL for database mlflow,
# with the psycopg2 driver MLflow expects:
#   postgresql+psycopg2://USER:PASSWORD@HOST/mlflow?sslmode=require
#
# Reuse the existing TENSORLANE_PEPPER and TENSORLANE_SECRET_KEY. Generating a
# new pepper invalidates every live API key and invite.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://USER:PASSWORD@HOST/mlflow?sslmode=require
TENSORLANE_PEPPER=
TENSORLANE_SECRET_KEY=
WEB_ORIGIN=https://tensorla.vercel.app
PUBLIC_URL=https://tensorla.vercel.app
ENVIRONMENT=production
MLFLOW_INTERNAL_URI=http://127.0.0.1:5000
MLFLOW_STATIC_PREFIX=/mlflow
WEB_INTERNAL_URI=
ARTIFACT_ROOT=file:///var/mlflow/artifacts
CONTROL_PLANE_RPM=0
MLFLOW_WRITE_RPM=0
TRACE_INGEST_RPM=0
