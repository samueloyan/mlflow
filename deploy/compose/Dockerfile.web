FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY tensorlane/web/package.json tensorlane/web/package-lock.json tensorlane/web/.npmrc ./
RUN npm ci --omit=optional --min-release-age=7

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY tensorlane/web ./
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATABASE_URL=postgresql://tensorlane:tensorlane@127.0.0.1:5432/tensorlane
ENV BETTER_AUTH_SECRET=build-secret
ENV BETTER_AUTH_URL=http://localhost:8080
ENV NEXT_PUBLIC_APP_URL=http://localhost:8080
ENV NEXT_PUBLIC_TRACKING_URI=http://localhost:8080
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
